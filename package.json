{
  "name": "proxy-toggler",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "aymenhammouda",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/bluecloud-dev/proxy-toggler#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluecloud-dev/proxy-toggler.git"
  },
  "bugs": {
    "url": "https://github.com/bluecloud-dev/proxy-toggler/issues"
  },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "assets/**",
    "LICENSE",
    "package.nls.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "proxyToggler.enable",
        "title": "%command.enable.title%"
      },
      {
        "command": "proxyToggler.disable",
        "title": "%command.disable.title%"
      },
      {
        "command": "proxyToggler.toggle",
        "title": "%command.toggle.title%"
      },
      {
        "command": "proxyToggler.configure",
        "title": "%command.configure.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "proxyToggler.enable",
          "when": "proxyToggler.hasConfiguration && !proxyToggler.isEnabled"
        },
        {
          "command": "proxyToggler.disable",
          "when": "proxyToggler.hasConfiguration && proxyToggler.isEnabled"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "proxyToggler.confirmBeforeToggle": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.confirmBeforeToggle.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "check": "npm run format:check && npm run lint && npm run lint:unused && npm run typecheck && npm run coverage",
    "check:no-telemetry": "node ./scripts/check-no-telemetry.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts esbuild.js eslint.config.mjs",
    "lint:unused": "knip",
    "typecheck": "tsc -p . --noEmit",
    "test": "mocha",
    "test:integration": "node ./esbuild.js && tsc -p . && ts-node ./tests/run-test.ts",
    "test:packaged": "tsc -p . && ts-node ./tests/run-packaged-test.ts",
    "coverage": "node -r ./scripts/patch-os-cpus.cjs ./node_modules/nyc/bin/nyc.js npm test",
    "vscode:prepublish": "npm run typecheck && node ./esbuild.js --production",
    "package": "node -r ./scripts/patch-os-cpus.cjs ./node_modules/@vscode/vsce/vsce package && node ./scripts/check-package.cjs"
  },
  "nyc": {
    "all": true,
    "check-coverage": true,
    "concurrency": 1,
    "branches": 80,
    "functions": 80,
    "lines": 80,
    "statements": 80,
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "out/**",
      "dist/**",
      "tests/**",
      "src/extension.ts"
    ],
    "include": [
      "src/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "require": [
      "ts-node/register"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.27.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "knip": "^6.42.0",
    "mocha": "^11.8.0",
    "nyc": "^17.1.0",
    "prettier": "3.9.10",
    "sinon": "^19.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "yauzl": "^2.10.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "allowScripts": {
    "@vscode/vsce-sign": false,
    "esbuild": false,
    "keytar": false
  }
}
